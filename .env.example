# Copy to .env (or export these directly) to override defaults.
# See app/config.py for the full list and what each one does.

API_KEYS=dev-local-key,another-key-for-a-second-client
RATE_LIMIT_PER_MINUTE=30

STORAGE_ROOT=storage

MAX_UPLOAD_BYTES=524288000

CHUNK_THRESHOLD_SECONDS=300
CHUNK_LENGTH_SECONDS=240
CHUNK_OVERLAP_SECONDS=5
MAX_CONCURRENT_CHUNKS=3

INLINE_TRANSCRIPT_MAX_CHARS=20000

# "whisper" for the real model, "mock" to run the whole pipeline without
# downloading anything (used in this repo's own test suite).
TRANSCRIPTION_ENGINE=mock
WHISPER_MODEL_SIZE=base

MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=2
