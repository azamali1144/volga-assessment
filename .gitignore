__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env

# runtime data generated by the app - never commit uploaded audio,
# generated transcripts, or the local SQLite DB
storage/audio/*
storage/transcripts/*
storage/dead_letter/*
storage/*.db
storage/*.db-journal
storage/*.db-wal
storage/*.db-shm
!storage/audio/.gitkeep
!storage/transcripts/.gitkeep
!storage/dead_letter/.gitkeep

.DS_Store
*.egg-info/
